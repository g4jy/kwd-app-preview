[{"id":"n00377","kind":"word","ko":"캐나다","yo":"","en":"Canada","pos":"명사","usage":"","contract":"","examples":[{"id":"e00795","ko":"캐나다는 겨울이 아주 추워요.","en":"Winters in Canada are very cold.","speech_level":"해요","cloze":"캐나다","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e00796","ko":"제 친구가 캐나다에서 왔어요.","en":"My friend is from Canada.","speech_level":"해요","cloze":"캐나다","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11724","ko":"캐나다는 한국에서 아주 멀어요.","en":"Canada is very far from Korea.","speech_level":"해요","cloze":"캐나다","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11725","ko":"캐나다는 어때요? — 아주 넓어요.","en":"What is Canada like? — It's very big.","speech_level":"해요","cloze":"캐나다","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11726","ko":"여름에 캐나다에 갈 거예요.","en":"I'm going to go to Canada in the summer.","speech_level":"해요","cloze":"캐나다","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"캐나다","roman":"kaenada","explain":"“카나다”가 아니라 “캐나다”라고 써요. 첫 글자는 “캐”예요. 발음도 [캐나다]예요.","video_url":"","video_title":"","phrases":[],"pron_source":"wiktionary","pron_why":null,"dict_examples":[],"explain_en":"It is written 캐나다, not 카나다. The first letter is 캐, and you say it that way too.","contract_en":""},{"id":"n00386","kind":"word","ko":"프랑스","yo":"","en":"France","pos":"명사","usage":"","contract":"","examples":[{"id":"e00801","ko":"파리는 프랑스에 있어요.","en":"Paris is in France.","speech_level":"해요","cloze":"프랑스","extra_word":"파리 = Paris","extra_grammar":"","tip":"","tip_en":""},{"id":"e00802","ko":"저는 프랑스 영화를 좋아해요.","en":"I like French films.","speech_level":"해요","cloze":"프랑스","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11727","ko":"프랑스 친구하고 파리에서 만나요.","en":"I'm meeting my French friend in Paris.","speech_level":"해요","cloze":"프랑스","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11728","ko":"프랑스는 빵이 유명해요.","en":"France is famous for its bread.","speech_level":"해요","cloze":"프랑스","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11729","ko":"올해 프랑스에 갈 거예요.","en":"I'm going to France this year.","speech_level":"해요","cloze":"프랑스","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"프랑스","roman":"peurangseu","explain":"나라 이름 뒤에 “어”를 붙이면 그 나라 말이 돼요. 프랑스어, 중국어, 일본어가 그래요. 영어만 조금 달라요.","video_url":"","video_title":"","phrases":[],"pron_source":"wiktionary","pron_why":null,"dict_examples":[],"explain_en":"Add 어 after a country name to get its language: 프랑스어, 중국어, 일본어. English is the odd one out: 영어, not 영국어.","contract_en":""},{"id":"n00385","kind":"word","ko":"베트남","yo":"","en":"Vietnam","pos":"명사","usage":"","contract":"","examples":[{"id":"e01315","ko":"베트남에서는 아침에 국수를 많이 먹어요.","en":"In Vietnam, people often eat noodles for breakfast.","speech_level":"해요","cloze":"베트남","extra_word":"국수 = noodles","extra_grammar":"","tip":"","tip_en":""},{"id":"e01316","ko":"베트남 커피는 아주 달아요.","en":"Vietnamese coffee is very sweet.","speech_level":"해요","cloze":"베트남","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11730","ko":"베트남 쌀국수를 먹고 싶어요.","en":"I want to eat Vietnamese rice noodles.","speech_level":"해요","cloze":"베트남","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11731","ko":"베트남에서 친구가 한국에 왔어요.","en":"A friend came to Korea from Vietnam.","speech_level":"해요","cloze":"베트남","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11732","ko":"내일 베트남 친구를 만날 거예요.","en":"I'm going to meet my Vietnamese friend tomorrow.","speech_level":"해요","cloze":"베트남","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"베트남","roman":"beteunam","explain":"한국어로는 “비엣남”이 아니라 “베트남”이에요. 처음 소리가 “베”예요. 쌀국수 가게도 “베트남 쌀국수”라고 많이 써요.","video_url":"","video_title":"","phrases":[],"pron_source":"wiktionary","pron_why":null,"dict_examples":[],"explain_en":"In Korean it is 베트남, not 비엣남. It starts with the sound 베. Noodle shops often put 베트남 in the name too: 베트남 쌀국수.","contract_en":""},{"id":"n00382","kind":"word","ko":"러시아","yo":"","en":"Russia","pos":"명사","usage":"","contract":"","examples":[{"id":"e01311","ko":"러시아의 겨울은 정말 길고 추워요.","en":"Russian winters are really long and cold.","speech_level":"해요","cloze":"러시아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e01312","ko":"러시아는 세계에서 제일 큰 나라예요.","en":"Russia is the biggest country in the world.","speech_level":"해요","cloze":"러시아","extra_word":"세계 = the world","extra_grammar":"","tip":"","tip_en":""},{"id":"e11733","ko":"러시아는 나라가 아주 커요.","en":"Russia is a very big country.","speech_level":"해요","cloze":"러시아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11734","ko":"러시아 친구는 김치를 좋아해요.","en":"My Russian friend likes kimchi.","speech_level":"해요","cloze":"러시아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11735","ko":"겨울에 러시아에 가고 싶어요.","en":"I want to go to Russia in winter.","speech_level":"해요","cloze":"러시아","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"러시아","roman":"reosia","explain":"“로시아”가 아니라 “러시아”예요. 첫 글자가 “러”예요. 러시아 말은 “러시아어”예요.","video_url":"","video_title":"","phrases":[],"pron_source":"wiktionary","pron_why":null,"dict_examples":[],"explain_en":"It is 러시아, not 로시아. The first letter is 러. The language is 러시아어.","contract_en":""},{"id":"n00384","kind":"word","ko":"몽골","yo":"","en":"Mongolia","pos":"명사","usage":"","contract":"","examples":[{"id":"e01313","ko":"몽골 사람들은 말을 잘 타요.","en":"Mongolians are good at riding horses.","speech_level":"해요","cloze":"몽골","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e01314","ko":"몽골에는 사람보다 말이 더 많아요.","en":"Mongolia has more horses than people.","speech_level":"해요","cloze":"몽골","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11736","ko":"몽골 친구가 서울 회사에서 일해요.","en":"My Mongolian friend works at a company in Seoul.","speech_level":"해요","cloze":"몽골","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11737","ko":"몽골은 하늘이 정말 예뻐요.","en":"The sky in Mongolia is really beautiful.","speech_level":"해요","cloze":"몽골","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11738","ko":"다음 달에 몽골에서 친구가 와요.","en":"A friend is coming from Mongolia next month.","speech_level":"해요","cloze":"몽골","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"몽골","roman":"monggol","explain":"예전에는 “몽고”라고도 썼어요. 지금은 “몽골”이라고 써요. 오래된 책이나 말에서 “몽고”가 나오기도 해요.","video_url":"","video_title":"","phrases":[],"pron_source":"wiktionary","pron_why":null,"dict_examples":[],"explain_en":"It used to be written 몽고 in Korean too. Today you write 몽골. You may still see 몽고 in older books or hear it in older speech.","contract_en":""},{"id":"n00374","kind":"word","ko":"말레이시아","yo":"","en":"Malaysia","pos":"명사","usage":"","contract":"","examples":[{"id":"e01305","ko":"말레이시아는 일 년 내내 더워요.","en":"Malaysia is hot all year round.","speech_level":"해요","cloze":"말레이시아","extra_word":"내내 = throughout","extra_grammar":"","tip":"","tip_en":""},{"id":"e01306","ko":"말레이시아에서 온 친구가 있어요.","en":"I have a friend from Malaysia.","speech_level":"해요","cloze":"말레이시아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11739","ko":"말레이시아는 비가 자주 와요.","en":"It rains often in Malaysia.","speech_level":"해요","cloze":"말레이시아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11740","ko":"우리 동네에 말레이시아 음식점이 있어요.","en":"There is a Malaysian restaurant in our neighborhood.","speech_level":"해요","cloze":"말레이시아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11741","ko":"방학에 말레이시아에서 친구를 만났어요.","en":"I met a friend in Malaysia during vacation.","speech_level":"해요","cloze":"말레이시아","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"말레이시아","roman":"malleisia","explain":"“말레이시아”와 “인도네시아”는 이름이 비슷해서 헷갈려요. “말레이”로 시작하면 말레이시아, “인도네”로 시작하면 인도네시아예요.","video_url":"","video_title":"","phrases":[],"pron_source":"wiktionary","pron_why":null,"dict_examples":[],"explain_en":"말레이시아 and 인도네시아 look alike and are easy to mix up. If it starts with 말레이 it is Malaysia; if it starts with 인도네 it is Indonesia.","contract_en":""},{"id":"n00379","kind":"word","ko":"인도네시아","yo":"","en":"Indonesia","pos":"명사","usage":"","contract":"","examples":[{"id":"e01309","ko":"인도네시아에는 섬이 아주 많아요.","en":"Indonesia has a lot of islands.","speech_level":"해요","cloze":"인도네시아","extra_word":"섬 = island","extra_grammar":"","tip":"","tip_en":""},{"id":"e01310","ko":"인도네시아 발리에 가고 싶어요.","en":"I want to go to Bali in Indonesia.","speech_level":"해요","cloze":"인도네시아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11742","ko":"인도네시아 친구가 한국 노래를 좋아해요.","en":"My Indonesian friend likes Korean songs.","speech_level":"해요","cloze":"인도네시아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11743","ko":"작년에 인도네시아에서 일했어요.","en":"I worked in Indonesia last year.","speech_level":"해요","cloze":"인도네시아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11744","ko":"인도네시아는 어디에 있어요? — 말레이시아 옆에 있어요.","en":"Where is Indonesia? — It is next to Malaysia.","speech_level":"해요","cloze":"인도네시아","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"인도네시아","roman":"indonesia","explain":"이름이 길어서 뉴스에서는 “인니”라고 줄여서 쓰기도 해요. 보통 말할 때는 “인도네시아”라고 해요.","video_url":"","video_title":"","phrases":[],"pron_source":"wiktionary","pron_why":null,"dict_examples":[],"explain_en":"The name is long, so news and online text sometimes shorten it to 인니. In normal speech you say 인도네시아.","contract_en":""},{"id":"n04133","kind":"word","ko":"브라질","yo":"","en":"Brazil","pos":"명사","usage":"","contract":"","examples":[{"id":"e08244","ko":"저는 브라질 사람이에요.","en":"I'm Brazilian.","speech_level":"해요","cloze":"브라질","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e08245","ko":"브라질에 가고 싶어요.","en":"I want to go to Brazil.","speech_level":"해요","cloze":"브라질","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11745","ko":"브라질은 커피가 유명해요.","en":"Brazil is famous for coffee.","speech_level":"해요","cloze":"브라질","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11746","ko":"브라질 친구하고 점심을 먹어요.","en":"I have lunch with my Brazilian friend.","speech_level":"해요","cloze":"브라질","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11747","ko":"브라질은 어디에 있어요? — 남미에 있어요.","en":"Where is Brazil? — It is in South America.","speech_level":"해요","cloze":"브라질","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"브라질","roman":"beurajil","explain":"브라질 사람들은 스페인어가 아니라 포르투갈어를 써요. 남미에서 포르투갈어를 쓰는 큰 나라는 브라질이에요.","video_url":"","video_title":"","phrases":[],"pron_source":"auto","pron_why":null,"dict_examples":[],"explain_en":"People in Brazil speak Portuguese, not Spanish. Brazil is the big Portuguese-speaking country in South America.","contract_en":""},{"id":"n04134","kind":"word","ko":"스페인","yo":"","en":"Spain","pos":"명사","usage":"","contract":"","examples":[{"id":"e08246","ko":"저는 스페인 사람이에요.","en":"I'm Spanish.","speech_level":"해요","cloze":"스페인","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e08247","ko":"스페인에 가고 싶어요.","en":"I want to go to Spain.","speech_level":"해요","cloze":"스페인","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11748","ko":"스페인은 여름에 아주 더워요.","en":"Spain is very hot in summer.","speech_level":"해요","cloze":"스페인","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11749","ko":"스페인 음식을 좋아해요? — 네, 파에야를 좋아해요.","en":"Do you like Spanish food? — Yes, I like paella.","speech_level":"해요","cloze":"스페인","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11750","ko":"스페인에서 축구 경기를 봤어요.","en":"I watched a soccer match in Spain.","speech_level":"해요","cloze":"스페인","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"스페인","roman":"seupein","explain":"“에스파냐”라는 이름도 있어요. 하지만 보통은 “스페인”이라고 말해요. 말은 “스페인어”예요.","video_url":"","video_title":"","phrases":[],"pron_source":"auto","pron_why":null,"dict_examples":[],"explain_en":"It also has the name “에스파냐”. But people usually say “스페인”. The language is “스페인어”.","contract_en":""},{"id":"n04135","kind":"word","ko":"멕시코","yo":"","en":"Mexico","pos":"명사","usage":"","contract":"","examples":[{"id":"e08248","ko":"저는 멕시코 사람이에요.","en":"I'm Mexican.","speech_level":"해요","cloze":"멕시코","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e08249","ko":"멕시코에 가고 싶어요.","en":"I want to go to Mexico.","speech_level":"해요","cloze":"멕시코","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11751","ko":"멕시코 음식점에서 타코를 먹어요.","en":"I eat tacos at a Mexican restaurant.","speech_level":"해요","cloze":"멕시코","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11752","ko":"멕시코 친구가 서울에 살아요.","en":"My Mexican friend lives in Seoul.","speech_level":"해요","cloze":"멕시코","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11753","ko":"멕시코는 사람이 정말 많아요.","en":"Mexico has a really large population.","speech_level":"해요","cloze":"멕시코","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"멕씨코","roman":"meksiko","explain":"“멕시코”는 [멕씨코]로 소리 나요. ㄱ 받침 뒤의 ㅅ이 된소리가 돼요. 글자는 “시”인데 [씨]로 말해요.","video_url":"","video_title":"","phrases":[],"pron_source":"curriculum","pron_why":{"ch":[[1,"c","tense",-1]],"rules":["tense"],"long":[]},"dict_examples":[],"explain_en":"“멕시코” is pronounced [멕씨코]. After a ㄱ final consonant, ㅅ becomes a tense sound. It's written “시” but said [씨].","contract_en":""},{"id":"n04136","kind":"word","ko":"이탈리아","yo":"","en":"Italy","pos":"명사","usage":"","contract":"","examples":[{"id":"e08250","ko":"저는 이탈리아 사람이에요.","en":"I'm Italian.","speech_level":"해요","cloze":"이탈리아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e08251","ko":"이탈리아에 가고 싶어요.","en":"I want to go to Italy.","speech_level":"해요","cloze":"이탈리아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11754","ko":"이탈리아 식당에서 피자를 먹어요.","en":"I eat pizza at an Italian restaurant.","speech_level":"해요","cloze":"이탈리아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11755","ko":"이탈리아 친구는 커피를 아주 좋아해요.","en":"My Italian friend loves coffee.","speech_level":"해요","cloze":"이탈리아","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11756","ko":"이탈리아 신발을 샀어요. 정말 편해요.","en":"I bought Italian shoes. They are really comfortable.","speech_level":"해요","cloze":"이탈리아","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"이탈리아","roman":"itallia","explain":"예전 이름 “이태리”를 아직도 가끔 들을 수 있어요. 지금 이름은 “이탈리아”예요.","video_url":"","video_title":"","phrases":[],"pron_source":"auto","pron_why":null,"dict_examples":[],"explain_en":"You may still sometimes hear the old name “이태리”. The current name is “이탈리아”.","contract_en":""},{"id":"n04137","kind":"word","ko":"인도","yo":"","en":"India","pos":"명사","usage":"","contract":"","examples":[{"id":"e08252","ko":"저는 인도 사람이에요.","en":"I'm Indian.","speech_level":"해요","cloze":"인도","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e08253","ko":"인도에 가고 싶어요.","en":"I want to go to India.","speech_level":"해요","cloze":"인도","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11757","ko":"인도 음식점에서 난을 먹어요.","en":"I eat naan at an Indian restaurant.","speech_level":"해요","cloze":"인도","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11758","ko":"인도는 사람이 아주 많아요.","en":"India has a huge number of people.","speech_level":"해요","cloze":"인도","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11759","ko":"인도에서는 영어도 많이 써요.","en":"People also use English a lot in India.","speech_level":"해요","cloze":"인도","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"인도","roman":"indo","explain":"“인도”는 길 옆의 사람이 걷는 길도 뜻해요. 소리는 같아요. 어느 뜻인지는 앞뒤 말을 보고 알아요.","video_url":"","video_title":"","phrases":[],"pron_source":"auto","pron_why":null,"dict_examples":[],"explain_en":"“인도” also means a sidewalk, the path where people walk beside a road. The two words sound the same. You can tell which one it is from the words around it.","contract_en":""},{"id":"n04138","kind":"word","ko":"필리핀","yo":"","en":"the Philippines","pos":"명사","usage":"","contract":"","examples":[{"id":"e08254","ko":"저는 필리핀 사람이에요.","en":"I'm Filipino.","speech_level":"해요","cloze":"필리핀","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e08255","ko":"필리핀에 가고 싶어요.","en":"I want to go to the Philippines.","speech_level":"해요","cloze":"필리핀","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11760","ko":"필리핀 바다는 정말 예뻐요.","en":"The sea in the Philippines is really beautiful.","speech_level":"해요","cloze":"필리핀","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11761","ko":"필리핀 친구가 영어를 잘해요.","en":"My Filipino friend speaks English well.","speech_level":"해요","cloze":"필리핀","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11762","ko":"필리핀 망고는 아주 달아요.","en":"Philippine mangoes are very sweet.","speech_level":"해요","cloze":"필리핀","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"필리핀","roman":"pillipin","explain":"한국어에는 영어의 F 소리가 없어요. 그래서 F를 “ㅍ”으로 써요. 필리핀의 “필”은 Phil이에요. 프랑스의 “프”도 그래요.","video_url":"","video_title":"","phrases":[],"pron_source":"auto","pron_why":null,"dict_examples":[],"explain_en":"Korean has no English F sound, so F is written with “ㅍ”. The “필” in 필리핀 is Phil. The “프” in 프랑스 (France) works the same way.","contract_en":""},{"id":"n04139","kind":"word","ko":"튀르키예","yo":"","en":"Türkiye (Turkey)","pos":"명사","usage":"","contract":"","examples":[{"id":"e08256","ko":"저는 튀르키예 사람이에요.","en":"I'm Turkish.","speech_level":"해요","cloze":"튀르키예","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e08257","ko":"튀르키예에 가고 싶어요.","en":"I want to go to Türkiye (Turkey).","speech_level":"해요","cloze":"튀르키예","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11763","ko":"튀르키예는 커피와 차가 유명해요.","en":"Türkiye is famous for coffee and tea.","speech_level":"해요","cloze":"튀르키예","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11764","ko":"튀르키예 친구는 한국을 좋아해요.","en":"My Turkish friend likes Korea.","speech_level":"해요","cloze":"튀르키예","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11765","ko":"내년에 튀르키예 여행을 갈 거예요.","en":"I'm going on a trip to Türkiye next year.","speech_level":"해요","cloze":"튀르키예","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"튀르키예","roman":"twireukiye","explain":"예전에는 “터키”라고 많이 썼어요. 지금은 나라 이름이 “튀르키예”예요. 하지만 사람들은 아직 “터키”라고도 말해요.","video_url":"","video_title":"","phrases":[],"pron_source":"auto","pron_why":null,"dict_examples":[],"explain_en":"People used to write “터키” a lot. Now the country's name is “튀르키예”. But people still say “터키” too.","contract_en":""},{"id":"n04140","kind":"word","ko":"이집트","yo":"","en":"Egypt","pos":"명사","usage":"","contract":"","examples":[{"id":"e08258","ko":"저는 이집트 사람이에요.","en":"I'm Egyptian.","speech_level":"해요","cloze":"이집트","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e08259","ko":"이집트에 가고 싶어요.","en":"I want to go to Egypt.","speech_level":"해요","cloze":"이집트","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11766","ko":"이집트에는 피라미드가 있어요.","en":"There are pyramids in Egypt.","speech_level":"해요","cloze":"이집트","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11767","ko":"이집트 친구가 한국 드라마를 봐요.","en":"My Egyptian friend watches Korean dramas.","speech_level":"해요","cloze":"이집트","extra_word":"","extra_grammar":"","tip":"","tip_en":""},{"id":"e11768","ko":"이집트에서 사진을 많이 찍었어요.","en":"I took a lot of photos in Egypt.","speech_level":"해요","cloze":"이집트","extra_word":"","extra_grammar":"","tip":"","tip_en":""}],"pron":"이집트","roman":"ijipteu","explain":"이집트 사람들은 아랍어를 써요. ‘이집트어’라고 하지 않아요. ‘나라 이름 + 어’ 규칙이 맞지 않는 나라예요.","video_url":"","video_title":"","phrases":[],"pron_source":"auto","pron_why":null,"dict_examples":[],"explain_en":"Egyptians speak Arabic; Koreans don't say '이집트어'. It's a country where the 'country name + 어' rule for languages doesn't work.","contract_en":""}]